# Copy to .env and supply your own local PostgreSQL credentials.
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/kenyan_stoic_dev
BACKEND_ADDR=127.0.0.1:3000
RUST_LOG=info
# Draft creation is disabled by default. Enable only for local development.
ENABLE_LOCAL_AUTHORING=false
# Optional override; defaults accept both localhost:5173 and 127.0.0.1:5173.
# LOCAL_AUTHORING_ORIGIN=http://127.0.0.1:5173
